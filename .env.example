# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this example file is committed so others know which variables exist.

# Used by the postgres container to create the database on first start
POSTGRES_USER=relay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=relay

# Used by the app when running on your Mac (outside Docker). Inside Docker,
# docker-compose.yml overrides these to point at the "postgres" and "redis" containers.
DATABASE_URL=postgresql+asyncpg://relay:change-me@localhost:5432/relay
REDIS_URL=redis://localhost:6379/0
